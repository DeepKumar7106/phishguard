# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (e.g. https://app.vercel.app).
# Leave empty to allow all origins (development only).
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Database (required) - PostgreSQL, e.g. Neon / Supabase / RDS
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Redis (optional cache). Leave empty to run without caching.
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Ollama / Qwen (optional). When unreachable or disabled, the deterministic
# fallback engine is used automatically.
# ---------------------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=25000
